# Reference only. Wrangler local development reads .dev.vars, not this file.
# Copy .dev.vars.example to .dev.vars and generate separate LOCAL secrets.
API_KEY=
# Exactly 32 random bytes, base64 encoded: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional SSO: >=32 characters, shared only with a trusted issuer.
ADMIN_SSO_SECRET=
# Optional inspection credential for non-testers; same Threads app as user tokens.
THREADS_APP_ACCESS_TOKEN=
